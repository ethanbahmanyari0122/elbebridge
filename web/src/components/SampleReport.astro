---
/**
 * The public explanation of the v5 findings-report structure. It links to the
 * anonymized examples on the homepage; prospect and client evidence is never
 * published here.
 */
import Icon from './Icon.astro';
import { inline, paragraphs } from '../lib/inline';
import type { Copy, Locale } from '../lib/site';
import { localePath } from '../lib/site';
interface Props { copy: Copy; locale: Locale }
const { copy, locale } = Astro.props;
const s = copy.sample;
---
<section class="sample-head">
  <h1 set:html={inline(s.title)} />
  {paragraphs(s.intro).map((t) => <p class="lede" set:html={inline(t)} />)}

  <div class="hero-actions">
    <a class="btn btn-primary" href={s.fileHref}>
      <Icon name="document" size={18} />{s.downloadLabel}
    </a>
  </div>
  <p class="file-meta">{s.fileMeta}</p>
</section>

<section class="band-plain" aria-labelledby="sample-pages-h">
  <h2 class="section-title" id="sample-pages-h" set:html={inline(s.pagesHeading)} />
  <ol class="sample-pages">
    {s.pages.map((p) => (
      <li>
        <span class="cp-n">{p.n}</span>
        <span class="body">
          <strong set:html={inline(p.heading)} />
          <p set:html={inline(p.text)} />
        </span>
      </li>
    ))}
  </ol>
  <p class="prose sample-note" set:html={inline(s.note)} />
</section>

<section class="band-plain" aria-labelledby="sample-cta-h">
  <h2 class="section-title" id="sample-cta-h" set:html={inline(s.ctaHeading)} />
  <p class="prose" set:html={inline(s.ctaText)} />
  <div class="hero-actions">
    <a class="btn btn-primary" href={localePath(locale, '/#check')}>
      {s.ctaLabel}<Icon name="arrow-right" size={18} />
    </a>
  </div>
</section>
