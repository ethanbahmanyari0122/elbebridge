---
interface Props { href: string; label: string; class?: string }
const { href, label, class: className } = Astro.props;
---
<a class:list={['wordmark', className]} href={href}>
  <img class="wordmark-mark" src="/elbebridge-mark.jpg" width="48" height="48" alt="" />
  <span class="wordmark-text">{label}</span>
</a>
