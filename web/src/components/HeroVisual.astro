---
import Icon from './Icon.astro';
import type { Copy, Locale } from '../lib/site';
import { localePath } from '../lib/site';
interface Props { copy: Copy; locale: Locale }
const { copy, locale } = Astro.props;
/** Each checkpoint goes to its own card, not to the top of the section. */
const cardHref = (code: string) => localePath(locale, `/#obligation-${code.toLowerCase()}`);
const art = copy.home.heroImage;
---
{/*
  Two renderings of the same idea, one visible at a time.

  On a wide screen: Ornella's illustration — a parcel crossing into Germany
  through the three checkpoints. It says more in a glance than markup can, and
  it is decorative here because everything in it is stated as real text below.

  On a phone, and anywhere the locale has no artwork of its own: the linked
  list. It stays legible at 390px, translates with the rest of the page, and
  each checkpoint is a real link to the section that explains it — which the
  picture cannot be.
*/}
<div class="hero-visual">
  {art && (
    <img
      class="hero-art"
      src={art.src}
      width={art.width}
      height={art.height}
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  )}

  <div class:list={['journey', art && 'journey-compact']}>
    <div class="journey-start" aria-hidden="true">
      <span class="parcel"><Icon name="box" size={26} /></span>
      <span class="track"></span>
    </div>

    <ol class="checkpoints">
      {copy.home.obligations.map((o, i) => (
        <li>
          <a href={cardHref(o.code)}>
            <span class="cp-n">{String(i + 1).padStart(2, '0')}</span>
            <span class="cp-icon"><Icon name={o.icon} size={19} /></span>
            <span class="cp-text">
              <span class="cp-code">{o.code}</span>
              <span class="cp-label">{o.short}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>

    <p class="journey-end"><Icon name="check" size={18} />{copy.home.journeyEnd}</p>
  </div>
</div>
