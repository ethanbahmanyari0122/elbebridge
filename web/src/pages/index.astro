---
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';
import { loadCopy } from '../lib/site';
const copy = await loadCopy('en');
---
<Base locale="en" pageKey="home" title={copy.site.title} description={copy.site.metaDescription} bleed>
  <Home copy={copy} locale="en" />
</Base>
