---
/** German legal pages, generated from src/content/copy/de.json. */
import Base from '../../layouts/Base.astro';
import LegalPage from '../../components/LegalPage.astro';
import { loadCopy } from '../../lib/site';

export async function getStaticPaths() {
  const copy = await loadCopy('de');
  return copy.legal.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const copy = await loadCopy('de');
---
<Base
  locale="de"
  pageKey={page.key}
  title={`${page.title} — ${copy.site.wordmark}`}
  description={page.metaDescription}
  contentLang={page.lang}
  bodyClass="legal-page"
>
  <div class="legal"><LegalPage page={page} /></div>
</Base>
